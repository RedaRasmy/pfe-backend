{
    "compilerOptions": {
        /* File Layout */
        "rootDir": ".",
        "outDir": "./dist",

        /* Modules */
        "module": "commonjs",
        "target": "es2020",
        // "moduleResolution": "node",

        /* Node environment */
        "lib": ["esnext"],
        // "types": ["node"],

        /* Other Outputs */
        "sourceMap": true,
        "declaration": false,

        /* Strictness */
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,

        /* Compatibility */
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src", "drizzle.config.ts"],
    "exclude": ["node_modules", "dist"],

    "ts-node": {
        "require": ["tsconfig-paths/register"],
        // IMPORTANT: When running source files, the project root is the source.
        "project": "./tsconfig.json"
    }
}
